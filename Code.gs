/** สร้างทุกชีตพร้อมหัวตาราง + ค่าเริ่มต้น (ไม่ลบข้อมูลเดิม) */
function setupAllSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  ensureSheets(ss);

  const majors = ss.getSheetByName(SHEET_MAJORS);
  if (majors.getLastRow() <= 1) writeRows(majors, DEFAULT_MAJORS.map(function (m, i) { return [i + 1, m]; }));

  const terms = ss.getSheetByName(SHEET_TERMS);
  if (terms.getLastRow() <= 1) {
    const y = String(new Date().getFullYear() + 543);
    writeRows(terms, [[y + '/1', y, 'ภาคเรียนที่ 1', '', '', true, new Date().toISOString()]]);
  }

  const st = ss.getSheetByName(SHEET_SETTINGS);
  if (!readSettings(ss).semester) {
    upsertSetting(st, 'semester', JSON.stringify({
      targetSessions: 12, semesterName: 'ภาคเรียนที่ 1', academicYear: String(new Date().getFullYear() + 543), activityDay: 'ทุกวันพุธ'
    }));
  }
  upsertSetting(st, 'appTitle', 'ระบบเช็คชื่อกลุ่มศึกษาอัลกุรอาน (หะละเกาะห์)');
  showAllData();
}

